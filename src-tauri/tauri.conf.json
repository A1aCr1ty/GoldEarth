{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoldEarth",
  "version": "0.1.0",
  "identifier": "com.goldearth.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../app"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "GoldEarth",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/archify/**/*"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

# Node
node_modules/
app/dist/
app/*.tsbuildinfo
app/vite.config.js
app/vite.config.d.ts

# Rust
src-tauri/target/
src-tauri/gen/
# tauri-build 按 build.rs 里的命令名单自动生成的 allow-*/deny-* 权限文件。
# 每次构建都会重写，跟着提交只会制造无意义的 diff。permissions/app.toml
# 才是手写的那份。
src-tauri/permissions/autogenerated/

# 本地配置与密钥（不要提交）
.env
.env.*
!.env.example

# 缓存
*.tsbuildinfo
app/.vite/

# 日志与临时产物
*.log
*.tmp
*.bak
.runlogs/
recovered-notes/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
